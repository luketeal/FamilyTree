@page "/settings"
@inject ITreeDataAdministration TreeData
@inject TreeStatsService Stats
@inject TreeDataNotifier Notifier

<PageTitle>Settings — FamilyTree</PageTitle>

<section class="settings">
    <h1>Settings</h1>

    <div class="settings__card">
        <h2>Your data</h2>
        <p class="settings__lede">
            Everything lives in this browser. Nothing is sent anywhere, which also
            means this device holds the only copy.
        </p>

        <dl class="settings__facts">
            <dt>In this tree</dt>
            <dd data-testid="settings-stats">@_stats</dd>

            <dt>Storage</dt>
            <dd data-testid="settings-persistence">@PersistenceLabel</dd>
        </dl>
    </div>

    <div class="settings__card">
        <h2>Sample family</h2>
        <p class="settings__lede">
            A demonstration tree containing half-siblings, an adoption, a remarriage
            after widowhood, an unidentified ancestor, and a relationship the family
            is unsure about — the cases this app exists to handle.
        </p>

        <div class="settings__actions">
            <button type="button" class="btn btn--primary" data-testid="load-sample"
                    disabled="@_busy" @onclick="() => RequestAsync(DestructiveAction.LoadSample)">
                Load sample family
            </button>
            <button type="button" class="btn btn--secondary" data-testid="clear-data"
                    disabled="@_busy" @onclick="() => RequestAsync(DestructiveAction.Clear)">
                Clear everything
            </button>
        </div>

        @if (_pending is not null)
        {
            <div class="settings__confirm" role="alertdialog" aria-labelledby="confirm-title"
                 data-testid="settings-confirm">
                <p id="confirm-title" class="settings__confirm-text" data-testid="settings-confirm-text">
                    @ConfirmPrompt
                </p>
                <div class="settings__actions">
                    <button type="button" class="btn btn--destructive" data-testid="confirm-destructive"
                            disabled="@_busy" @onclick="ConfirmAsync">
                        @ConfirmLabel
                    </button>
                    <button type="button" class="btn btn--secondary" data-testid="cancel-destructive"
                            disabled="@_busy" @onclick="Cancel">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (_message is not null)
        {
            <p class="settings__message" data-testid="settings-message">@_message</p>
        }
    </div>
</section>

@code {
    private enum DestructiveAction
    {
        LoadSample,
        Clear,
    }

    private TreeStats _stats = TreeStats.Empty;
    private StorageDurability? _durability;
    private string? _message;
    private bool _busy;
    private DestructiveAction? _pending;

    private string PersistenceLabel => _durability switch
    {
        null => "Checking…",
        { Supported: false } => "This browser cannot guarantee persistence",
        { Persistent: true } => "Persistent — the browser will not evict this data automatically",
        _ => "Best effort — the browser may evict this data under storage pressure",
    };

    private string ConfirmLabel => _pending switch
    {
        DestructiveAction.LoadSample => "Replace my tree",
        _ => "Delete everything",
    };

    // Names what is about to be lost rather than asking a generic "are you sure".
    // There is no backup and no undo yet, so the count is the only warning the
    // user gets that this is not recoverable.
    private string ConfirmPrompt
    {
        get
        {
            var held = $"{Describe(_stats.People, "person", "people")} and {Describe(_stats.Relationships, "relationship", "relationships")}";
            return _pending switch
            {
                DestructiveAction.LoadSample =>
                    $"Loading the sample family replaces your tree. The {held} in this browser will be permanently deleted, and there is no undo.",
                _ =>
                    $"This permanently deletes the {held} in this browser. There is no undo.",
            };
        }
    }

    private static string Describe(int count, string singular, string plural) =>
        $"{count} {(count == 1 ? singular : plural)}";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    // Confirmation is only worth the friction when there is something to lose.
    // On an empty tree both actions are no-ops, so they run straight through.
    private async Task RequestAsync(DestructiveAction action)
    {
        if (_stats.People == 0 && _stats.Relationships == 0)
        {
            await RunAsync(action);
            return;
        }

        _pending = action;
        _message = null;
    }

    private void Cancel()
    {
        _pending = null;
        _message = "Nothing was changed.";
    }

    private async Task ConfirmAsync()
    {
        if (_pending is not { } action)
        {
            return;
        }

        _pending = null;
        await RunAsync(action);
    }

    private async Task RunAsync(DestructiveAction action)
    {
        _busy = true;
        try
        {
            if (action == DestructiveAction.LoadSample)
            {
                // Replaces rather than merges, in one transaction: loading the
                // sample twice should give the same tree, not two overlapping
                // families.
                await TreeData.LoadSampleFamilyAsync();
                await AfterChangeAsync("Sample family loaded.");
            }
            else
            {
                await TreeData.ClearAsync();
                await AfterChangeAsync("All data cleared.");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AfterChangeAsync(string message)
    {
        _message = message;
        await RefreshAsync();
        await Notifier.NotifyChangedAsync();
    }

    private async Task RefreshAsync()
    {
        var stats = await Stats.GetAsync();
        if (stats.IsSuccess)
        {
            _stats = stats.Value!;
        }

        _durability = await TreeData.EnsureDurableAsync();
    }
}
