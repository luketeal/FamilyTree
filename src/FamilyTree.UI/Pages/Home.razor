@page "/"

<PageTitle>FamilyTree</PageTitle>

<section class="home">
    <div class="home__empty" data-testid="home-empty-state">
        <h1>Add your first person</h1>
        <p>Your tree is empty. Start by adding yourself or someone you remember well.</p>
        <button type="button" class="btn btn--primary" disabled>
            Add person
        </button>
        <p class="home__hint">The Add Person flow lands in the next PR.</p>
    </div>
</section>
