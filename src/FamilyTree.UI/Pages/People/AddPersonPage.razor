@page "/people/add"
@inject PersonService People
@inject TreeDataNotifier Notifier
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Add person — FamilyTree</PageTitle>

@* A person form is legitimately taller than a phone viewport, so it declares
   itself scrollable. Horizontal overflow is still checked with no exemption. *@
<section class="person-edit" data-scrolls>
    <header class="person-edit__header">
        <h1>Add person</h1>
        <a class="person-edit__back" href="people">Back to people</a>
    </header>

    <PersonForm @ref="_form"
                Person="_seed"
                SubmitLabel="Save person"
                Error="@_error"
                Busy="_busy"
                Submit="SaveAsync"
                Cancel="GoBack" />
</section>

@code {
    private PersonForm? _form;
    private PersonDetailDto? _seed;
    private string? _error;
    private bool _busy;

    // Carried over from the quick-add popover's "Open full form" (US-053), so
    // switching to the full form does not cost the user what they already typed.
    [SupplyParameterFromQuery(Name = "first")] private string? FirstName { get; set; }

    [SupplyParameterFromQuery(Name = "last")] private string? LastName { get; set; }

    [SupplyParameterFromQuery(Name = "born")] private int? BornYear { get; set; }

    [SupplyParameterFromQuery(Name = "died")] private int? DiedYear { get; set; }

    [SupplyParameterFromQuery(Name = "gender")] private string? GenderName { get; set; }

    protected override void OnParametersSet()
    {
        if (FirstName is null && LastName is null && BornYear is null && DiedYear is null && GenderName is null)
        {
            return;
        }

        // A DTO purely to seed the form. Nothing is stored until the user saves,
        // so the id is a throwaway.
        _seed = new PersonDetailDto(
            Guid.Empty,
            FirstName ?? string.Empty,
            LastName ?? string.Empty,
            null,
            SafeYear(BornYear),
            null,
            SafeYear(DiedYear),
            null,
            Enum.TryParse<Gender>(GenderName, out var gender) ? gender : Gender.Unknown,
            null,
            null,
            false);

        _error = UnrepresentableYearMessage();
    }

    /// <summary>
    /// Guards only what <see cref="PartialDate"/> can physically hold, so a
    /// hand-edited query string cannot throw on the way into the form.
    /// </summary>
    /// <remarks>
    /// This deliberately no longer decides whether a year is <em>acceptable</em>
    /// — that rule lives in PartialDateInput and PersonService. It used to allow
    /// anything up to 9999 while the rest of the app stopped at next year, so
    /// years in the gap were seeded as valid, never judged, and saved.
    /// </remarks>
    private static PartialDate? SafeYear(int? year) =>
        year is int value && value >= 1 && value <= 9999 ? PartialDate.FromYear(value) : null;

    // Anything PartialDate cannot hold is gone from the field, so say so.
    // Emptying the box silently told the user the year had been accepted when it
    // had been discarded — the same silent-loss class as saving it wrongly.
    private string? UnrepresentableYearMessage()
    {
        var dropped = new List<string>(2);

        if (BornYear is not null && SafeYear(BornYear) is null)
        {
            dropped.Add($"birth year {BornYear}");
        }

        if (DiedYear is not null && SafeYear(DiedYear) is null)
        {
            dropped.Add($"death year {DiedYear}");
        }

        return dropped.Count == 0
            ? null
            : $"Could not carry over the {string.Join(" or the ", dropped)} — a year must be between 1 and 9999.";
    }

    private async Task SaveAsync(PersonService.PersonInput input)
    {
        _busy = true;
        try
        {
            var result = await People.CreateAsync(input);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            _form?.MarkSaved();
            await Notifier.NotifyChangedAsync();

            Toasts.Show($"{result.Value!.DisplayName} saved.");

            // A duplicate is a warning, not a rejection — two cousins genuinely
            // can share a name and a birth year, so the person was saved. Raised
            // as a warning toast because it must survive the navigation below
            // and stay put until the user has actually read it.
            if (result.IsWarning)
            {
                Toasts.Show(result.Warning!, ToastLevel.Warning);
            }

            Nav.NavigateTo($"people/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("people");
}
