@page "/people/add"
@inject PersonService People
@inject TreeDataNotifier Notifier
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Add person — FamilyTree</PageTitle>

@* A person form is legitimately taller than a phone viewport, so it declares
   itself scrollable. Horizontal overflow is still checked with no exemption. *@
<section class="person-edit" data-scrolls>
    <header class="person-edit__header">
        <h1>Add person</h1>
        <a class="person-edit__back" href="people">Back to people</a>
    </header>

    @* Keyed on the carry-over, so arriving with a different one builds a fresh
       form rather than reusing the one on screen. Both this page and the form
       below it seed exactly once and then let the user own the fields — which is
       what stops a keystroke being overwritten by a re-render, and equally what
       would silently drop a carry-over that arrived while the form was already
       open. The popover lives in the top bar, so that is reachable from this
       very page: open it here, type a year, choose "Open full form", and the
       route does not change, only the query string. A new key is the difference
       between "the same form, re-rendered" and "a different form". *@
    <PersonForm @ref="_form"
                @key="_seedKey"
                Person="_seed"
                BirthDateSeed="_birthSeed"
                DeathDateSeed="_deathSeed"
                SubmitLabel="Save person"
                Error="@_error"
                Busy="_busy"
                Submit="SaveAsync"
                Cancel="GoBack" />
</section>

@code {
    private PersonForm? _form;
    private PersonDetailDto? _seed;
    private PartialDateText? _birthSeed;
    private PartialDateText? _deathSeed;
    private string _seedKey = string.Empty;
    private string? _error;
    private bool _busy;

    // Carried over from the quick-add popover's "Open full form" (US-053), so
    // switching to the full form does not cost the user what they already typed.
    [SupplyParameterFromQuery(Name = "first")] private string? FirstName { get; set; }

    [SupplyParameterFromQuery(Name = "last")] private string? LastName { get; set; }

    /// <summary>
    /// Deliberately a string rather than an <c>int?</c>. Blazor binds a query
    /// value it cannot parse as null, so <c>?born=abc</c> was discarded here —
    /// one level before anything could report it — which is the same class of
    /// loss as an out-of-range year: a type that cannot express "typed something
    /// invalid" leaves the caller nothing to carry.
    /// </summary>
    [SupplyParameterFromQuery(Name = "born")] private string? BornYear { get; set; }

    [SupplyParameterFromQuery(Name = "died")] private string? DiedYear { get; set; }

    [SupplyParameterFromQuery(Name = "gender")] private string? GenderName { get; set; }

    protected override void OnParametersSet()
    {
        // The whole query string rather than the individual values: two
        // carry-overs that differ in any field have to be different keys, and
        // navigating back to a bare people/add has to be a different key again
        // or the previous person's details arrive pre-filled.
        _seedKey = new Uri(Nav.Uri).Query;

        if (FirstName is null && LastName is null && BornYear is null && DiedYear is null && GenderName is null)
        {
            _seed = null;
            _birthSeed = null;
            _deathSeed = null;
            return;
        }

        // A DTO purely to seed the form. Nothing is stored until the user saves,
        // so the id is a throwaway. The dates are deliberately absent from it:
        // they travel as raw text instead, because a PartialDate cannot hold a
        // year the user typed but the type will not accept, and this page used
        // to have to drop such a year and then apologise for it. Now it lands in
        // the box, where the control judges it and the user can correct it.
        _seed = new PersonDetailDto(
            Id: Guid.Empty,
            FirstName: FirstName ?? string.Empty,
            LastName: LastName ?? string.Empty,
            BirthSurname: null,
            BirthDate: null,
            BirthPlace: null,
            DeathDate: null,
            DeathPlace: null,
            Gender: Enum.TryParse<Gender>(GenderName, out var gender) ? gender : Gender.Unknown,
            PhotoPath: null,
            Notes: null,
            IsPhantom: false);

        _birthSeed = PartialDateText.FromYearText(BornYear);
        _deathSeed = PartialDateText.FromYearText(DiedYear);
    }

    private async Task SaveAsync(PersonService.PersonInput input)
    {
        _busy = true;
        try
        {
            var result = await People.CreateAsync(input);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            _form?.MarkSaved();
            await Notifier.NotifyChangedAsync();

            Toasts.Show($"{result.Value!.DisplayName} saved.");

            // A duplicate is a warning, not a rejection — two cousins genuinely
            // can share a name and a birth year, so the person was saved. Raised
            // as a warning toast because it must survive the navigation below
            // and stay put until the user has actually read it.
            if (result.IsWarning)
            {
                Toasts.Show(result.Warning!, ToastLevel.Warning);
            }

            Nav.NavigateTo($"people/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("people");
}
