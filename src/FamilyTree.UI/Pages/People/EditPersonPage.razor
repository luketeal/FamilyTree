@page "/people/{Id:guid}/edit"
@inject PersonService People
@inject MarriageService Marriages
@inject TreeDataNotifier Notifier
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(_person is null ? "Edit person" : $"Edit {_person.DisplayName}") — FamilyTree</PageTitle>

<section class="person-edit" data-scrolls>
    <header class="person-edit__header">
        <h1>Edit person</h1>
        <a class="person-edit__back" href="@($"people/{Id}")">Back to profile</a>
    </header>

    @if (_loading)
    {
        <p class="person-edit__status" data-testid="edit-loading">Loading…</p>
    }
    else if (_person is null)
    {
        <ErrorAlert Message="@(_error ?? "That person no longer exists.")" TestId="edit-missing" />
        <a class="btn btn--secondary" href="people">Back to people</a>
    }
    else
    {
        <PersonForm @ref="_form"
                    Person="_person"
                    SubmitLabel="Save changes"
                    Error="@_error"
                    Busy="_busy"
                    Submit="SaveAsync"
                    Cancel="GoBack" />
    }
</section>

@code {
    private PersonForm? _form;
    private PersonDetailDto? _person;
    private string? _error;
    private bool _busy;
    private bool _loading = true;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var result = await People.GetAsync(Id);

        if (result.IsSuccess)
        {
            _person = result.Value;
            _error = null;
        }
        else
        {
            _person = null;
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task SaveAsync(PersonService.PersonInput input)
    {
        _busy = true;
        try
        {
            // Captured before the write, because the review notice below asks
            // whether this save changed it.
            var before = _person?.DeathDate;

            var result = await People.UpdateAsync(Id, input);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _error = null;

            // Before navigating, so the form stops reporting unsaved changes
            // even if the navigation is cancelled.
            _form?.MarkSaved();
            await Notifier.NotifyChangedAsync();

            Toasts.Show($"{result.Value!.DisplayName} updated.");

            // US-026's third criterion, and it asks specifically about a death date
            // that was *updated*. Raised after the save rather than as part of it,
            // and as a warning rather than a correction: the app cannot tell
            // whether the marriage or the death date is the one that is now wrong,
            // and quietly rewriting a recorded end date would overwrite research
            // with an inference.
            //
            // Gated on the date actually changing, which is this page's business
            // rather than the service's — the service is handed one person and
            // cannot see what they looked like a moment ago. Without the gate the
            // notice fired on every save of anybody dead with an ongoing marriage,
            // opening "X is now recorded as dying in 1991" after an edit that
            // touched a spelling, which is a false sentence and trains people to
            // dismiss the toast that matters.
            if (!Equals(before, result.Value!.DeathDate))
            {
                var review = await Marriages.DescribeEndDateReviewAsync(Id);
                if (review is not null)
                {
                    Toasts.Show(review, ToastLevel.Warning);
                }
            }

            Nav.NavigateTo($"people/{Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack() => Nav.NavigateTo($"people/{Id}");
}
