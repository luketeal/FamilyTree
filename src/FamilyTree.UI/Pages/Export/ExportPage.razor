@page "/export"
@inject ExportService Export
@inject BackupTracker Backups
@inject IFileDownloadInterop Download
@inject TreeStatsService Stats
@inject ToastService Toasts

<PageTitle>Export — FamilyTree</PageTitle>

<section class="data-page">
    <header class="data-page__header">
        <h1>Export</h1>
        <p class="data-page__lede">
            Your tree lives in this browser and nowhere else. Clearing site data,
            switching device, or a browser that reclaims storage takes it with no
            warning — a downloaded file is the only copy that survives any of that.
        </p>
    </header>

    <div class="data-card">
        <dl class="data-facts">
            <dt>Backup</dt>
            <dd data-testid="export-status">@_status.Describe()</dd>

            <dt>In this tree</dt>
            <dd data-testid="export-tree-stats">@_stats</dd>
        </dl>

        @if (_status.ShouldPrompt)
        {
            <ErrorAlert Kind="ErrorAlert.AlertKind.Warning" TestId="export-stale"
                        Message="@UnsavedMessage" />
        }

        <div class="data-card__actions">
            <button type="button" class="btn btn--primary" data-testid="export-download"
                    disabled="@_busy" @onclick="DownloadAsync">
                @(_busy ? "Preparing…" : "Download a backup")
            </button>
            <a class="btn btn--secondary" href="import" data-testid="export-to-import">
                Restore from a file
            </a>
        </div>

        <ErrorAlert Message="@_error" TestId="export-error" />

        @if (_lastExport is { } done)
        {
            <div class="data-report" role="status" data-testid="export-summary">
                <p class="data-report__headline">
                    Saved @done.Summary.Describe() to <code>@done.FileName</code>.
                </p>
                <p class="data-report__note">
                    Keep it somewhere that is not this computer — another drive, or
                    somewhere it is backed up for you.
                </p>

                @if (done.Summary.Phantoms > 0)
                {
                    @* Named rather than left to be inferred from a count that does
                       not add up. Placeholders are in the file but not in the
                       people total, so somebody comparing the two numbers needs
                       telling why. *@
                    <p class="data-report__note" data-testid="export-phantom-note">
                        @Describe(done.Summary.Phantoms, "unidentified ancestor", "unidentified ancestors")
                        @(done.Summary.Phantoms == 1 ? "is" : "are") saved too, kept separate from the
                        people so they stay out of lists — but included, so the relationships that
                        point at @(done.Summary.Phantoms == 1 ? "them" : "them") come back with the rest.
                    </p>
                }
            </div>
        }
    </div>

    <div class="data-card">
        <h2>What is in the file</h2>
        <p class="data-page__lede">
            Indented JSON, stamped with the format version so a later release can
            still read it. People, unidentified ancestors, biological and adoptive
            links, and marriages — everything this version of the app stores. You
            can open it in any text editor to check it is really your tree.
        </p>
    </div>
</section>

@code {
    private BackupStatus _status = BackupStatus.None;
    private TreeStats _stats = TreeStats.Empty;
    private ExportPayload? _lastExport;
    private string? _error;
    private bool _busy;

    private string UnsavedMessage => _status.LastExport is null
        ? "This tree has never been exported. If this browser loses its data, there is nothing to restore from."
        // Describe() rather than the raw day count, which renders "0 days ago"
        // on the most common path of all: export, add somebody, come back here.
        : $"This tree has changed since the last backup. {_status.Describe()}, "
            + "so anything added since then exists only here.";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task DownloadAsync()
    {
        _busy = true;
        _error = null;
        _lastExport = null;

        try
        {
            var result = await Export.ExportToJsonAsync();
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            var payload = result.Value!;
            await Download.DownloadTextAsync(payload.FileName, payload.Json);

            // Recorded only after the browser has been handed the file. Marking a
            // tree as backed up on the strength of a download that never happened
            // is the one bug in here that would cost somebody their data.
            await Backups.RecordExportAsync(payload.ExportedAt);

            _lastExport = payload;
            Toasts.Show($"Exported {payload.Summary.Describe()}.");
            await RefreshAsync();
        }
        catch (JSException ex)
        {
            _error = $"The browser would not save the file: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        var stats = await Stats.GetAsync();
        if (stats.IsSuccess)
        {
            _stats = stats.Value!;
        }

        // IsEmpty counts phantoms, which the displayed people count excludes: a
        // tree of nothing but unidentified ancestors still holds records worth
        // protecting.
        _status = await Backups.GetStatusAsync(hasData: !_stats.IsEmpty);
    }

    private static string Describe(int count, string singular, string plural) =>
        $"{count} {(count == 1 ? singular : plural)}";
}
