@inherits LayoutComponentBase
@inject ITreeDataAdministration TreeData

<div class="shell">
    <IconRail />
    <div class="shell__main">
        <TopBar />
        @* Above the content rather than inside a page, because the thing it
           warns about is true on every page. *@
        <BackupReminder />
        <main class="shell__content">
            @Body
        </main>
    </div>
</div>

@* Rendered once here rather than per page, so a confirmation raised by a page
   survives that page navigating away as part of its own success. *@
<ToastNotification />

@code {
    // The browser holds the only copy of the user's tree (ADR-004), so eviction
    // is data loss rather than a cache miss. Asking once per session on first
    // render — the earliest point the Blazor runtime can reach a JS module.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await TreeData.EnsureDurableAsync();
        }
        catch (Exception ex)
        {
            // A browser that refuses or lacks the API must not break the shell;
            // the Settings page reports whatever status resulted.
            Console.Error.WriteLine($"Could not request persistent storage: {ex.Message}");
        }
    }
}
