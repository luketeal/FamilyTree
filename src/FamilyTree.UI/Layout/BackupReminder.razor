@* A standing prompt to export, shown when this browser holds records it has
   never written to a file — or has not written for a week.

   The browser is the only copy (ADR-004), so a user who never exports is one
   cleared cache from losing everything, with nothing in the interface having
   ever said so. That makes this a durability mechanism rather than a nudge,
   which is why it sits in the shell and not on a page somebody has to find. *@

@implements IDisposable
@inject IExportHistory History
@inject TreeStatsService Stats
@inject TimeProvider Clock
@inject TreeDataNotifier Notifier
@inject NavigationManager Nav

@if (Visible)
{
    <div class="reminder" role="status" data-testid="backup-reminder">
        <svg class="reminder__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l9 16H3z"></path>
            <path d="M12 9v4M12 16v.5"></path>
        </svg>

        <p class="reminder__text" data-testid="backup-reminder-text">@Message</p>

        <a class="btn btn--primary reminder__action" href="export" data-testid="backup-reminder-export">
            Export a backup
        </a>

        <button type="button" class="btn btn--ghost btn--icon reminder__dismiss"
                data-testid="backup-reminder-dismiss" aria-label="Dismiss this reminder"
                @onclick="Dismiss">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>
    </div>
}

@code {
    private BackupStatus? _status;
    private bool _dismissed;

    // Hidden on the export page itself, where it would be telling the user to do
    // the thing they are already looking at.
    private bool Visible => _status is { IsStale: true, HasData: true }
        && !_dismissed
        && !CurrentPathIs("export");

    private string Message => _status?.LastExport is null
        ? "This tree has never been backed up. If this browser loses its data, there is nothing to restore from."
        : $"Last backed up {_status.DaysSince} days ago. Anything added since exists only in this browser.";

    protected override async Task OnInitializedAsync()
    {
        Notifier.Changed += RefreshAsync;

        // Exporting does not change the tree, so it does not raise the notifier —
        // but it does change whether this should be on screen. Navigation is the
        // reliable moment to re-check: leaving the export page is exactly when
        // the answer has just changed.
        Nav.LocationChanged += OnLocationChanged;

        await RefreshAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(RefreshAsync);

    private async Task RefreshAsync()
    {
        // Cached between changes, so this costs a dictionary lookup rather than
        // a read of all four stores on every navigation.
        var stats = await Stats.GetAsync();
        var lastExport = await History.GetLastExportAsync();

        // IsEmpty counts phantoms, which the displayed people count excludes: a
        // tree holding nothing but unidentified ancestors still has something to
        // lose.
        _status = BackupStatus.For(
            lastExport,
            Clock.GetUtcNow(),
            hasData: stats.IsSuccess && !stats.Value!.IsEmpty);

        await InvokeAsync(StateHasChanged);
    }

    // Dismissal lasts as long as the page does. Deliberately not persisted: a
    // reminder that can be switched off permanently is one that stops protecting
    // the person who most needed it.
    private void Dismiss() => _dismissed = true;

    private bool CurrentPathIs(string path) =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/')
            .Equals(path, StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        Notifier.Changed -= RefreshAsync;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
