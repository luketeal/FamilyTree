@* Left icon rail (64px). Five primary destinations.
   Icon paths mirror the 24-grid line icons in mid-tokens.jsx. *@

<nav class="rail" aria-label="Primary">
    <div class="rail__brand" aria-hidden="true">
        <svg class="rail__brand-mark" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="18" r="2"></circle>
            <circle cx="18" cy="18" r="2"></circle>
            <circle cx="12" cy="6" r="2"></circle>
            <path d="M12 8v3a3 3 0 0 1-3 3H6v2M12 8v3a3 3 0 0 0 3 3h3v2"></path>
        </svg>
    </div>

    <ul class="rail__items">
        <li>
            <NavLink class="rail__item" Match="NavLinkMatch.All" href="" data-testid="nav-tree" title="Tree">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6" cy="18" r="2"></circle>
                    <circle cx="18" cy="18" r="2"></circle>
                    <circle cx="12" cy="6" r="2"></circle>
                    <path d="M12 8v3a3 3 0 0 1-3 3H6v2M12 8v3a3 3 0 0 0 3 3h3v2"></path>
                </svg>
                <span class="rail__label">Tree</span>
            </NavLink>
        </li>
        <li>
            <NavLink class="rail__item" href="people" data-testid="nav-people" title="People">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="9" r="3"></circle>
                    <path d="M3 19c0-3 3-5 6-5s6 2 6 5"></path>
                    <path d="M16 6.5a3 3 0 0 1 0 5"></path>
                    <path d="M21 18.5c0-2-1.5-3.5-4-4"></path>
                </svg>
                <span class="rail__label">People</span>
            </NavLink>
        </li>
        <li>
            <NavLink class="rail__item" href="relationships" data-testid="nav-relate" title="Relate">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 14a4 4 0 0 0 5.6 0l3-3a4 4 0 0 0-5.6-5.6l-1 1"></path>
                    <path d="M14 10a4 4 0 0 0-5.6 0l-3 3a4 4 0 0 0 5.6 5.6l1-1"></path>
                </svg>
                <span class="rail__label">Relate</span>
            </NavLink>
        </li>
        @* Export sits in the rail rather than only behind Settings: it is the
           backup mechanism for an app whose data lives in one browser, and a
           backup nobody can find is not one. Paired with Import, arrows
           mirroring each other. This takes the rail past the five destinations
           in the mid-fidelity mockups, which were drawn before export existed. *@
        <li>
            <NavLink class="rail__item" href="export" data-testid="nav-export" title="Export">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 4v12M7 11l5 5 5-5"></path>
                    <path d="M5 20h14"></path>
                </svg>
                <span class="rail__label">Export</span>
            </NavLink>
        </li>
        <li>
            <NavLink class="rail__item" href="import" data-testid="nav-import" title="Import">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20V8M7 13l5-5 5 5"></path>
                    <path d="M5 4h14"></path>
                </svg>
                <span class="rail__label">Import</span>
            </NavLink>
        </li>
        <li>
            <NavLink class="rail__item" href="settings" data-testid="nav-settings" title="Settings">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"></path>
                </svg>
                <span class="rail__label">Settings</span>
            </NavLink>
        </li>
    </ul>
</nav>
