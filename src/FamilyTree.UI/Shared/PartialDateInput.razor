@* Year-only stub. PR 6 extends this in place to Year → Month → Day → Circa;
   the parameter contract is already PartialDate? so that change does not reach
   the pages using it.

   A genealogy record frequently knows the year and nothing else, so an ordinary
   <input type="date"> is the wrong control: it would force a month and day the
   source never recorded. PartialDate carries the precision explicitly. *@

<div class="pdate">
    <label class="field-label" for="@_yearId">@Label</label>
    <div class="pdate__row">
        @* Deliberately no min/max. Those put the field under native constraint
           validation, which refuses to submit the enclosing form — so Blazor
           never runs, nothing renders, and the save button reads as dead. The
           range is enforced below instead, where the app can say something. *@
        <div class="input pdate__year">
            <input id="@_yearId"
                   type="number"
                   inputmode="numeric"
                   placeholder="Year"
                   value="@_year"
                   data-testid="@TestId"
                   aria-invalid="@(_error is not null)"
                   @oninput="OnYearInput" />
        </div>

        <label class="pdate__circa">
            <input type="checkbox"
                   checked="@_isApproximate"
                   data-testid="@($"{TestId}-approx")"
                   @onchange="OnApproximateChanged" />
            <span>Approximate</span>
        </label>
    </div>

    @if (_error is not null)
    {
        <p class="pdate__error" data-testid="@($"error-{TestId}")">@_error</p>
    }
</div>

@code {
    private readonly string _yearId = $"pdate-{Guid.NewGuid():N}";

    private int? _year;
    private bool _isApproximate;
    private string? _error;

    /// <summary>
    /// Set once the parameter has been read, so later renders do not overwrite
    /// what the user is typing. Without it, clearing the year emits null, the
    /// parent re-renders, and the circa flag is re-seeded from that null —
    /// silently discarding a precision judgement because a neighbouring field
    /// was being corrected.
    /// </summary>
    private bool _seeded;

    // A year beyond next year is a typo rather than a record. Kept generous
    // rather than clamped to today so a birth recorded slightly ahead of the
    // clock does not get rejected over a time zone.
    private static int MaxYear => DateTime.UtcNow.Year + 1;

    [Parameter] public string Label { get; set; } = "Year";

    [Parameter] public PartialDate? Value { get; set; }

    [Parameter] public EventCallback<PartialDate?> ValueChanged { get; set; }

    /// <summary>
    /// Raised whenever the entered year becomes valid or invalid, so the form
    /// hosting this control can refuse to submit while it is out of range.
    /// </summary>
    [Parameter] public EventCallback<bool> InvalidChanged { get; set; }

    [Parameter] public string TestId { get; set; } = "partial-date";

    protected override void OnParametersSet()
    {
        if (_seeded)
        {
            return;
        }

        _seeded = true;
        _year = Value?.Year;
        _isApproximate = Value?.IsApproximate ?? false;
    }

    private async Task OnYearInput(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        _year = int.TryParse(raw, out var parsed) ? parsed : null;

        // Distinguish "nothing entered" from "entered something impossible".
        // An empty box is a perfectly good answer; 30000 is a typo.
        _error = string.IsNullOrWhiteSpace(raw) || InRange(_year)
            ? null
            : $"Year must be between 1 and {MaxYear}.";

        await EmitAsync();
    }

    private async Task OnApproximateChanged(ChangeEventArgs args)
    {
        _isApproximate = args.Value is true;
        await EmitAsync();
    }

    private static bool InRange(int? year) => year is int value && value >= 1 && value <= MaxYear;

    // An out-of-range year emits null rather than a PartialDate the domain would
    // reject. The error above is what tells the user; the null keeps an invalid
    // value out of the model.
    private async Task EmitAsync()
    {
        PartialDate? next = InRange(_year)
            ? PartialDate.FromYear(_year!.Value, _isApproximate)
            : null;

        Value = next;
        await ValueChanged.InvokeAsync(next);
        await InvalidChanged.InvokeAsync(_error is not null);
    }
}
