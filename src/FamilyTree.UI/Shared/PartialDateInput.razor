@using System.Globalization

@* US-045. Year → Month → Day → Circa, so a record that knows only "circa 1880"
   can say exactly that.

   A genealogy record frequently knows the year and nothing else, so an ordinary
   <input type="date"> is the wrong control: it would force a month and day the
   source never recorded. PartialDate carries the precision explicitly, and this
   control converts to it only on emit — the half-typed states in between are
   never a domain value. *@

<div class="pdate">
    <label class="field-label" for="@_yearId">@Label</label>
    <div class="pdate__row">
        @* Text rather than number, and deliberately no min/max. Both put the
           field under native constraint validation, which refuses to submit the
           enclosing form — so Blazor never runs, nothing renders, and the save
           button reads as dead. A number input is worse than that: its value is
           the empty string for anything that is not a number, so "abc" carried
           in from a query string was displayed as a blank box next to an error
           about a year the user could no longer see. inputmode keeps the numeric
           keypad on a phone; the range is enforced in C#, where the app can say
           something. *@
        <div class="input pdate__year">
            <input id="@_yearId"
                   type="text"
                   inputmode="numeric"
                   placeholder="Year"
                   value="@_text.Year"
                   data-testid="@TestId"
                   aria-invalid="@(_error is null ? null : "true")"
                   aria-describedby="@(_error is null ? null : ErrorId)"
                   @oninput="OnYearInput" />
        </div>

        <div class="input pdate__month">
            <select class="pdate__select"
                    aria-label="@($"{Label} month")"
                    data-testid="@($"{TestId}-month")"
                    aria-invalid="@(_error is null ? null : "true")"
                    aria-describedby="@(_error is null ? null : ErrorId)"
                    @onchange="OnMonthChanged">
                <option value="">Month</option>
                @for (var month = 1; month <= 12; month++)
                {
                    var value = month.ToString(CultureInfo.InvariantCulture);
                    <option value="@value" selected="@(_text.Month == value)">@MonthName(month)</option>
                }
            </select>
        </div>

        <div class="input pdate__day">
            <input type="text"
                   inputmode="numeric"
                   placeholder="Day"
                   value="@_text.Day"
                   aria-label="@($"{Label} day")"
                   data-testid="@($"{TestId}-day")"
                   aria-invalid="@(_error is null ? null : "true")"
                   aria-describedby="@(_error is null ? null : ErrorId)"
                   @oninput="OnDayInput" />
        </div>

        <label class="pdate__circa">
            <input type="checkbox"
                   checked="@_text.IsApproximate"
                   data-testid="@($"{TestId}-approx")"
                   @onchange="OnApproximateChanged" />
            <span>Approximate</span>
        </label>
    </div>

    @if (_error is not null)
    {
        <p class="pdate__error" id="@ErrorId" data-testid="@ErrorId">@_error</p>
    }
</div>

@code {
    private readonly string _yearId = $"pdate-{Guid.NewGuid():N}";

    private PartialDateText _text = PartialDateText.Empty;
    private string? _error;

    /// <summary>
    /// Set once the parameter has been read, so later renders do not overwrite
    /// what the user is typing. Without it, clearing the year emits null, the
    /// parent re-renders, and the circa flag is re-seeded from that null —
    /// silently discarding a precision judgement because a neighbouring field
    /// was being corrected.
    /// </summary>
    private bool _seeded;

    private string ErrorId => $"error-{TestId}";

    [Parameter] public string Label { get; set; } = "Date";

    /// <summary>
    /// What to put in the boxes, as raw text.
    /// </summary>
    /// <remarks>
    /// Read once, then owned by this control. Deliberately not a
    /// <see cref="PartialDate"/>: that type cannot express a value the user
    /// typed but which it cannot hold, so a caller seeding one has to decide
    /// what to do with an unrepresentable year before this control ever sees it
    /// — and dropping it was the only option available. See
    /// <see cref="PartialDateText"/>.
    /// </remarks>
    [Parameter] public PartialDateText Seed { get; set; } = PartialDateText.Empty;

    /// <summary>
    /// Raised with the domain value, or null while the boxes do not describe
    /// one. Parsing happens here and nowhere else, so an intermediate typing
    /// state is never emitted as a date.
    /// </summary>
    [Parameter] public EventCallback<PartialDate?> ValueChanged { get; set; }

    /// <summary>
    /// Raised whenever the entered date becomes valid or invalid, so the form
    /// hosting this control can refuse to submit while it is not a date.
    /// </summary>
    [Parameter] public EventCallback<bool> InvalidChanged { get; set; }

    [Parameter] public string TestId { get; set; } = "partial-date";

    protected override async Task OnParametersSetAsync()
    {
        if (_seeded)
        {
            return;
        }

        _seeded = true;
        _text = Seed;

        // A seeded value is judged exactly like a typed one, and emitted the
        // same way. Validity used to be computed only while typing, so a value
        // that arrived from the carry-over query string was never judged at all:
        // it seeded a valid-looking PartialDate, left InvalidChanged false, and
        // saved. The same value typed into these boxes was rejected — two paths
        // disagreeing about the same value in the same form.
        if (!_text.IsBlank)
        {
            await EmitAsync();
        }
    }

    private Task OnYearInput(ChangeEventArgs args) =>
        UpdateAsync(_text with { Year = Read(args) });

    // Clearing the month clears the day with it. A day without a month is not a
    // date — ExportedDate rejects that combination on import — so the control
    // must not be able to produce one.
    private Task OnMonthChanged(ChangeEventArgs args)
    {
        var month = Read(args);
        return UpdateAsync(month.Length == 0
            ? _text with { Month = string.Empty, Day = string.Empty }
            : _text with { Month = month });
    }

    private Task OnDayInput(ChangeEventArgs args) =>
        UpdateAsync(_text with { Day = Read(args) });

    private Task OnApproximateChanged(ChangeEventArgs args) =>
        UpdateAsync(_text with { IsApproximate = args.Value is true });

    private Task UpdateAsync(PartialDateText next)
    {
        _text = next;
        return EmitAsync();
    }

    private static string Read(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;

    private static string MonthName(int month) =>
        CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);

    // Anything the boxes do not yet describe emits null rather than a
    // PartialDate the domain would reject. The error is what tells the user;
    // the null keeps a value the app cannot store out of the model.
    private async Task EmitAsync()
    {
        _text.TryToDomain(out var date, out _error);

        await ValueChanged.InvokeAsync(date);
        await InvalidChanged.InvokeAsync(_error is not null);
    }
}
