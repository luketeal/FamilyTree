@inject BiologicalRelationshipService Relationships
@inject AdoptiveRelationshipService Adoptive
@inject MarriageService Marriages
@inject TreeDataNotifier Notifier
@inject ToastService Toasts
@inject IOverlayInterop Overlay
@implements IAsyncDisposable

@* The one dialog for recording a relationship, whatever kind it is: kind →
   person → details. It replaces the per-type modals the design originally had,
   because those differ in three fields and agree on everything else — the
   search, the exclusions, the guards, the focus handling and the mobile
   layout — and four copies of that is four places for them to drift.

   PR 8 added the adoptive kinds and cost exactly that: two Catalogue entries,
   an adoption-date field in the details step and a branch in SaveAsync. PR 9
   added the spouse kind at the same price.

   Stepparent labels deliberately do NOT come through here. Every other kind
   answers "who?" with a search of the whole tree; a stepparent is the person a
   parent married, so US-038 asks for the action next to those specific spouses.
   A wizard step offering a free search would invite recording a step
   relationship nothing in the tree supports, so that flow lives on the profile
   as a list of candidates instead. *@

@if (Visible)
{
    <div class="reldialog" data-testid="@TestId" data-overlay @ref="_overlay"
         @onclick="CancelAsync">
        <div class="reldialog__panel" role="dialog" aria-modal="true" aria-labelledby="@_titleId"
             tabindex="-1" @ref="_panel" @onkeydown="OnKeyDownAsync"
             @onclick:stopPropagation="true">

            <h2 id="@_titleId" class="reldialog__title">
                @DialogTitle
            </h2>

            <ol class="reldialog__steps" data-testid="@($"{TestId}-steps")">
                @foreach (var step in VisibleSteps)
                {
                    <li class="reldialog__step @(step == _step ? "reldialog__step--on" : null)"
                        aria-current="@(step == _step ? "step" : null)"
                        data-testid="@($"{TestId}-step-{step.ToString().ToLowerInvariant()}")">
                        @StepLabel(step)
                    </li>
                }
            </ol>

            <ErrorAlert Message="@_error" TestId="@($"{TestId}-error")" />

            <div class="reldialog__body">
                @if (_step == Step.Kind)
                {
                    <fieldset class="reldialog__kinds">
                        <legend class="field-label">What kind of relationship?</legend>
                        @foreach (var option in Offered)
                        {
                            <button type="button"
                                    class="reldialog__kind @(_kind == option.Kind ? "reldialog__kind--on" : null)"
                                    aria-pressed="@(_kind == option.Kind ? "true" : "false")"
                                    data-testid="@($"{TestId}-kind-{option.Kind.ToString().ToLowerInvariant()}")"
                                    @onclick="() => ChooseKind(option.Kind)">
                                <span class="reldialog__kind-title">@option.Title</span>
                                <span class="reldialog__kind-note">@option.Description</span>
                            </button>
                        }
                    </fieldset>
                }
                else if (_step == Step.Person)
                {
                    <PersonSearchSelect Label="@PersonStepLabel"
                                        TestId="@($"{TestId}-search")"
                                        Exclude="Exclude"
                                        Selected="_person"
                                        SelectedChanged="OnPersonChosen" />
                }
                else
                {
                    <div class="reldialog__details">
                        <p class="reldialog__summary" data-testid="@($"{TestId}-summary")">@SummarySentence</p>

                        @* Certainty is collected here for every kind. The lighter
                           strokes and badges that make Likely and Speculative
                           legible at a glance are PR 13 — this is the value, not
                           its treatment, and a plain select is the honest
                           placeholder for a segmented control that does not
                           exist yet. *@
                        <div class="reldialog__field">
                            <label class="field-label" for="@_certaintyId">How certain is this?</label>
                            <div class="input">
                                <select id="@_certaintyId" class="reldialog__select"
                                        data-testid="@($"{TestId}-certainty")"
                                        @onchange="OnCertaintyChanged">
                                    @foreach (var value in Enum.GetValues<RelationshipCertainty>())
                                    {
                                        <option value="@value" selected="@(_certainty == value)">
                                            @Humanise(value)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* US-014, US-015. Optional by design, and empty means
                           "Date unknown" rather than "not filled in yet": the
                           date an adoption was finalised is frequently not in the
                           record at all, and a required field would force
                           somebody to invent one. The profile says so in words
                           where the date would be.

                           The marriage dates, place and end reason arrived in
                           PR 9 as another branch in this same block.

                           A free-text note is deliberately absent: no
                           relationship entity carries one, so a box for it would
                           accept research and discard it on save. It arrives
                           when a field exists to hold it. *@
                        @if (IsAdoptive)
                        {
                            <div class="reldialog__field" data-testid="@($"{TestId}-adoption-date-field")">
                                @* Seed is tracked live rather than set once at
                                   open. This control is destroyed when the
                                   wizard leaves the Details step and rebuilt on
                                   return, re-seeding from whatever it is handed
                                   — so a stale seed makes the field disagree
                                   with the value the dialog is about to save.
                                   Tracking the raw text rather than the parsed
                                   value is what carries half-typed and
                                   unparseable input back intact. *@
                                <PartialDateInput Label="Adoption date (optional)"
                                                  TestId="@($"{TestId}-adoption-date")"
                                                  Seed="_adoptionDateSeed"
                                                  TextChanged="t => _adoptionDateSeed = t"
                                                  ValueChanged="OnAdoptionDateChanged"
                                                  InvalidChanged="v => _adoptionDateInvalid = v" />
                                <p class="reldialog__hint">
                                    Leave blank if the date is unknown.
                                </p>
                            </div>
                        }

                        @* US-021, US-023, US-025 to US-027. Every field the
                           stories name, in one form, because ending a marriage is
                           editing it: a separate "end this marriage" form would be
                           this one with two fields showing and the same rules to
                           re-enforce.

                           Unlike the adoption date, the start date is required —
                           US-021 says so, and a marriage with no date at all
                           cannot be placed in a sequence, which is what the
                           section is ordered by. *@
                        @if (IsMarriage)
                        {
                            <div class="reldialog__field" data-testid="@($"{TestId}-start-date-field")">
                                <PartialDateInput Label="Marriage date"
                                                  TestId="@($"{TestId}-start-date")"
                                                  Seed="_startDateSeed"
                                                  TextChanged="t => _startDateSeed = t"
                                                  ValueChanged="OnStartDateChanged"
                                                  InvalidChanged="v => _startDateInvalid = v" />
                            </div>

                            <div class="reldialog__field">
                                <label class="field-label" for="@_placeId">Place (optional)</label>
                                <div class="input">
                                    <input id="@_placeId" type="text" maxlength="200"
                                           placeholder="Where were they married?"
                                           value="@_startPlace"
                                           data-testid="@($"{TestId}-place")"
                                           @oninput="e => _startPlace = e.Value?.ToString()" />
                                </div>
                            </div>

                            @* "Still ongoing" is the first option and the default,
                               so recording a current marriage needs nothing said
                               about how it ended. The reasons read as the stories
                               word them — Divorced, Widowed, Annulled — rather than
                               as the enum's event names. *@
                            <div class="reldialog__field">
                                <label class="field-label" for="@_endReasonId">How did it end?</label>
                                <div class="input">
                                    <select id="@_endReasonId" class="reldialog__select"
                                            data-testid="@($"{TestId}-end-reason")"
                                            @onchange="OnEndReasonChangedAsync">
                                        <option value="" selected="@(_endReason is null)">Still ongoing</option>
                                        @foreach (var value in Enum.GetValues<MarriageEndReason>())
                                        {
                                            <option value="@value" selected="@(_endReason == value)">
                                                @Humanise(value)
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="reldialog__field" data-testid="@($"{TestId}-end-date-field")">
                                @* Keyed, unlike every other date control in the
                                   app, because this is the only one something
                                   other than the user fills in. PartialDateInput
                                   reads its seed once and then owns its own
                                   contents — the right contract for a control
                                   that must not have half-typed input yanked out
                                   from under it — so handing it a new seed does
                                   nothing on its own. Changing the key destroys
                                   and rebuilds it, which is what makes the
                                   US-026 offer visible in the box rather than
                                   only saved. The key moves when the offer is
                                   taken and at no other time, so typing never
                                   rebuilds the control mid-word. *@
                                <PartialDateInput @key="_endDateSeedGeneration"
                                                  Label="End date (optional)"
                                                  TestId="@($"{TestId}-end-date")"
                                                  Seed="_endDateSeed"
                                                  TextChanged="t => _endDateSeed = t"
                                                  ValueChanged="OnEndDateChanged"
                                                  InvalidChanged="v => _endDateInvalid = v" />

                                @* US-026. An offer rather than an auto-fill, and it
                                   says whose death the year came from: a date that
                                   appeared on its own is a guess the user cannot
                                   check. Only shown while the box is empty, so it
                                   never proposes to overwrite something typed. *@
                                @if (_deathSuggestion is { } suggestion && _endDateSeed.IsBlank)
                                {
                                    <button type="button" class="reldialog__suggest"
                                            data-testid="@($"{TestId}-use-death-date")"
                                            @onclick="() => UseSuggestedEndDate(suggestion)">
                                        Use @suggestion.Date — from @suggestion.PersonName's death
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reldialog__actions">
                @if (CanGoBack)
                {
                    <button type="button" class="btn btn--secondary" disabled="@_busy"
                            data-testid="@($"{TestId}-back")" @onclick="Back">
                        Back
                    </button>
                }

                @if (_step == Step.Details)
                {
                    @* Disabled on an unparseable date rather than failing on
                       save: the control already says what is wrong with it, and a
                       save that bounced off a date would report it a second time
                       in a different place. Gated on the kind — see CanSave — so a
                       date left invalid before switching kind cannot disable Save
                       on a form that shows no date field to correct. *@
                    <button type="button" class="btn btn--primary"
                            disabled="@(_busy || !CanSave)"
                            data-testid="@($"{TestId}-save")" @onclick="SaveAsync">
                        @SaveLabel
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn--primary" disabled="@(_busy || !CanGoNext)"
                            data-testid="@($"{TestId}-next")" @onclick="Next">
                        Next
                    </button>
                }

                <button type="button" class="btn btn--ghost" disabled="@_busy"
                        data-testid="@($"{TestId}-cancel")" @onclick="CancelAsync">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The kinds of relationship the wizard can record.</summary>
    /// <remarks>
    /// PR 7 offered the biological pair, PR 8 the adoptive one, and PR 9 the
    /// spouse. Stepparent is not here: see the note at the top of this file.
    /// </remarks>
    public enum RelationshipKind
    {
        BiologicalParent,
        BiologicalChild,
        AdoptiveParent,
        AdoptiveChild,
        Spouse,
    }

    private enum Step
    {
        Kind,
        Person,
        Details,
    }

    /// <summary>What each kind is called and what it means, in one place.</summary>
    public sealed record KindOption(RelationshipKind Kind, string Title, string Description);

    /// <summary>
    /// The adoptive link an edit opens on: who is recorded now, and the details
    /// the form starts from. US-016.
    /// </summary>
    public sealed record AdoptiveEdit(
        PersonSummaryDto Parent,
        PartialDate? AdoptionDate,
        RelationshipCertainty Certainty);

    private static readonly IReadOnlyList<KindOption> Catalogue =
    [
        new(RelationshipKind.BiologicalParent, "Biological parent",
            "Someone this person is descended from. At most two."),
        new(RelationshipKind.BiologicalChild, "Biological child",
            "Someone descended from this person."),
        new(RelationshipKind.AdoptiveParent, "Adoptive parent",
            "Someone who adopted this person. No limit on how many."),
        new(RelationshipKind.AdoptiveChild, "Adoptive child",
            "Someone this person adopted."),
        // "Spouse or partner", and the description says both, because the record
        // covers an unmarried partnership as readily as a marriage and nothing
        // here asks about either person's gender (US-044).
        new(RelationshipKind.Spouse, "Spouse or partner",
            "Someone this person married or partnered with. Any number, in sequence."),
    ];

    private readonly string _titleId = $"reldialog-{Guid.NewGuid():N}";
    private readonly string _certaintyId = $"certainty-{Guid.NewGuid():N}";
    private readonly string _placeId = $"place-{Guid.NewGuid():N}";
    private readonly string _endReasonId = $"endreason-{Guid.NewGuid():N}";

    private ElementReference _overlay;
    private ElementReference _panel;
    private bool _wasVisible;

    private Step _step = Step.Kind;
    private RelationshipKind _kind = RelationshipKind.BiologicalParent;
    private PersonSummaryDto? _person;
    private RelationshipCertainty _certainty = RelationshipCertainty.Confirmed;
    private PartialDate? _adoptionDate;
    private PartialDateText _adoptionDateSeed = PartialDateText.Empty;
    private bool _adoptionDateInvalid;

    // The marriage fields. Each date keeps its raw text alongside the parsed
    // value, for the reason the adoption date does: this control is destroyed
    // when the wizard leaves the Details step and re-seeded on return, so a seed
    // that could not hold half-typed input would silently discard it.
    private PartialDate? _startDate;
    private PartialDateText _startDateSeed = PartialDateText.Empty;
    private bool _startDateInvalid;
    private string? _startPlace;
    private PartialDate? _endDate;
    private PartialDateText _endDateSeed = PartialDateText.Empty;
    private bool _endDateInvalid;
    private MarriageEndReason? _endReason;
    private EndDateSuggestion? _deathSuggestion;

    /// <summary>
    /// Bumped when the end date is replaced programmatically, to force the date
    /// control to be rebuilt from its seed. See the note beside the control.
    /// </summary>
    private int _endDateSeedGeneration;

    private string? _error;
    private bool _busy;

    [Parameter] public bool Visible { get; set; }

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public Guid SubjectId { get; set; }

    [Parameter] public string SubjectName { get; set; } = "this person";

    /// <summary>Which kinds this caller offers. Trimmed to one, the first step is skipped.</summary>
    [Parameter] public IReadOnlyCollection<RelationshipKind> Kinds { get; set; } =
        [RelationshipKind.BiologicalParent, RelationshipKind.BiologicalChild];

    /// <summary>People who must not be offered — the subject, and anyone already linked.</summary>
    [Parameter] public IReadOnlyCollection<Guid> Exclude { get; set; } = [];

    /// <summary>
    /// The parent being corrected, when this dialog is replacing one rather than
    /// adding. US-009 asks for a confirmation naming the old parent and the new,
    /// which is what the details step becomes in this mode.
    /// </summary>
    [Parameter] public Guid? ReplacingParentId { get; set; }

    [Parameter] public string? ReplacingParentName { get; set; }

    /// <summary>
    /// An existing adoptive link being corrected, rather than a new one being
    /// added. US-016.
    /// </summary>
    /// <remarks>
    /// Distinct from <see cref="ReplacingParentId"/>, which is the biological
    /// correction, because the two stories ask for different things and the
    /// difference is not cosmetic. US-009 replaces one of two fixed parent slots,
    /// so the person must change and there is nothing else on the link to edit.
    /// US-016 asks for one control that can change the person <em>or</em> the
    /// adoption date, so it opens with the person already chosen and leaving them
    /// alone is a legitimate outcome — which is why this mode seeds
    /// <c>_person</c> and that one does not.
    /// </remarks>
    [Parameter] public AdoptiveEdit? Editing { get; set; }

    /// <summary>
    /// An existing marriage being corrected or ended, rather than a new one being
    /// recorded. US-023, US-025, US-026, US-027.
    /// </summary>
    /// <remarks>
    /// The DTO itself rather than a wrapper, because it already carries everything
    /// the form starts from — the spouse, both dates, the place, the reason and the
    /// certainty — and a second shape holding the same fields is a second thing to
    /// keep in step.
    /// <para>
    /// A third editing mode alongside <see cref="ReplacingParentId"/> and
    /// <see cref="Editing"/>, and genuinely a third shape rather than a variation:
    /// the biological one must change the person, the adoptive one may change the
    /// person or the date, and this one usually changes neither — ending a marriage
    /// adds a date and a reason to a record whose identity nobody is questioning.
    /// </para>
    /// </remarks>
    [Parameter] public MarriageDto? EditingMarriage { get; set; }

    /// <summary>Raised after a successful save so the caller can reload.</summary>
    [Parameter] public EventCallback Saved { get; set; }

    [Parameter] public string TestId { get; set; } = "relationship-dialog";

    private bool IsReplacing => ReplacingParentId is not null;

    private bool IsEditing => Editing is not null;

    private bool IsEditingMarriage => EditingMarriage is not null;

    private bool IsAdoptive =>
        _kind is RelationshipKind.AdoptiveParent or RelationshipKind.AdoptiveChild;

    private bool IsMarriage => _kind is RelationshipKind.Spouse;

    /// <summary>
    /// Whether the form is in a state worth saving.
    /// </summary>
    /// <remarks>
    /// Gated on the kind, so a date left unparseable before switching kind cannot
    /// disable Save on a form with no date field to correct. The marriage start
    /// date is the one required date in the app: US-021 asks for it, and the
    /// blank case is checked as well as the invalid one because an empty control
    /// is not invalid — it simply has not been filled in.
    /// </remarks>
    private bool CanSave => (IsAdoptive, IsMarriage) switch
    {
        (true, _) => !_adoptionDateInvalid,
        (_, true) => !_startDateInvalid && !_endDateInvalid && !_startDateSeed.IsBlank,
        _ => true,
    };

    private string DialogTitle => (IsReplacing, IsEditing, IsEditingMarriage) switch
    {
        (true, _, _) => $"Replace a parent of {SubjectName}",
        (_, true, _) => $"Edit an adoptive parent of {SubjectName}",
        (_, _, true) => $"Edit a marriage of {SubjectName}",
        _ => $"Add a relationship for {SubjectName}",
    };

    private string SaveLabel => (IsReplacing, IsEditing, IsEditingMarriage) switch
    {
        (true, _, _) => "Replace",
        (_, true, _) or (_, _, true) => "Save changes",
        _ => "Save",
    };

    private IReadOnlyList<KindOption> Offered =>
        [.. Catalogue.Where(o => Kinds.Contains(o.Kind))];

    /// <summary>
    /// The kind step disappears when there is nothing to choose. Making somebody
    /// confirm the only option is a step that exists for the code's convenience
    /// rather than theirs.
    /// </summary>
    private bool SkipKindStep => Offered.Count <= 1;

    private IReadOnlyList<Step> VisibleSteps => SkipKindStep
        ? [Step.Person, Step.Details]
        : [Step.Kind, Step.Person, Step.Details];

    private bool CanGoBack => _step != VisibleSteps[0];

    private bool CanGoNext => _step switch
    {
        Step.Kind => true,
        Step.Person => _person is not null,
        _ => false,
    };

    private string PersonStepLabel => _kind switch
    {
        RelationshipKind.BiologicalChild => "Who is the child?",
        RelationshipKind.AdoptiveChild => "Who is the adopted child?",
        RelationshipKind.AdoptiveParent => "Who is the adoptive parent?",
        // "Spouse or partner" rather than husband or wife, and it asks nothing
        // about gender (US-044).
        RelationshipKind.Spouse => "Who is the spouse or partner?",
        _ => "Who is the parent?",
    };

    private string SummarySentence
    {
        get
        {
            var name = _person?.DisplayName ?? "Nobody";

            if (IsReplacing)
            {
                return $"{ReplacingParentName} will be replaced by {name} "
                    + $"as a biological parent of {SubjectName}.";
            }

            if (IsEditingMarriage)
            {
                return _person?.Id == EditingMarriage!.Spouse.Id
                    ? $"{name} stays married to {SubjectName}, with the details below."
                    : $"{EditingMarriage!.Spouse.DisplayName} will be replaced by {name} "
                        + $"as the spouse of {SubjectName}.";
            }

            // In edit mode the chosen person may be the one already recorded, in
            // which case nothing is being replaced and saying so would be a lie
            // about what the button is about to do.
            if (IsEditing)
            {
                return _person?.Id == Editing!.Parent.Id
                    ? $"{name} stays an adoptive parent of {SubjectName}, with the details below."
                    : $"{Editing!.Parent.DisplayName} will be replaced by {name} "
                        + $"as an adoptive parent of {SubjectName}.";
            }

            return _kind switch
            {
                RelationshipKind.BiologicalChild =>
                    $"{name} will be recorded as a biological child of {SubjectName}.",
                RelationshipKind.AdoptiveChild =>
                    $"{name} will be recorded as an adoptive child of {SubjectName}.",
                RelationshipKind.AdoptiveParent =>
                    $"{name} will be recorded as an adoptive parent of {SubjectName}.",
                RelationshipKind.Spouse =>
                    $"{name} will be recorded as the spouse or partner of {SubjectName}.",
                _ => $"{name} will be recorded as a biological parent of {SubjectName}.",
            };
        }
    }

    private static string StepLabel(Step step) => step switch
    {
        Step.Kind => "Kind",
        Step.Person => "Person",
        _ => "Details",
    };

    private static string Humanise(RelationshipCertainty certainty) => certainty switch
    {
        RelationshipCertainty.Confirmed => "Confirmed",
        RelationshipCertainty.Likely => "Likely",
        _ => "Speculative",
    };

    /// <summary>
    /// The end reasons in the words the stories use rather than the enum's.
    /// </summary>
    /// <remarks>
    /// "Widowed" for <see cref="MarriageEndReason.DeathOfSpouse"/> (US-026) and
    /// "Divorced" rather than "Divorce" (US-025), matching what the profile row
    /// will say once it is saved. A dropdown that offered "DeathOfSpouse" and a row
    /// that then read "Widowed" would look like two different fields.
    /// </remarks>
    private static string Humanise(MarriageEndReason reason) => reason switch
    {
        MarriageEndReason.Divorce => "Divorced",
        MarriageEndReason.DeathOfSpouse => "Widowed — death of a spouse",
        MarriageEndReason.Annulment => "Annulled",
        MarriageEndReason.Separation => "Separated",
        _ => "Ended, reason unknown",
    };

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            Reset();
        }
    }

    /// <summary>
    /// Back to step one with nothing carried over.
    /// </summary>
    /// <remarks>
    /// Run when the dialog opens rather than when it closes, so a cancel halfway
    /// through cannot leave a person selected who is then saved against a
    /// different subject the next time it is opened.
    /// </remarks>
    private void Reset()
    {
        _step = SkipKindStep ? Step.Person : Step.Kind;
        _kind = Offered.Count > 0 ? Offered[0].Kind : RelationshipKind.BiologicalParent;

        // An edit opens on what is already recorded, so leaving every field
        // alone is a no-op rather than a way to blank the link. Seeding the date
        // as text rather than as a PartialDate is the PR 6 contract: a stored
        // value this control cannot express would otherwise have to be dropped
        // before the control ever saw it.
        _person = Editing?.Parent ?? EditingMarriage?.Spouse;
        _certainty = Editing?.Certainty
            ?? EditingMarriage?.Certainty
            ?? RelationshipCertainty.Confirmed;
        _adoptionDate = Editing?.AdoptionDate;
        _adoptionDateSeed = PartialDateText.From(Editing?.AdoptionDate);
        _adoptionDateInvalid = false;

        _startDate = EditingMarriage?.StartDate;
        _startDateSeed = PartialDateText.From(EditingMarriage?.StartDate);
        _startDateInvalid = false;
        _startPlace = EditingMarriage?.StartPlace;
        _endDate = EditingMarriage?.EndDate;
        _endDateSeed = PartialDateText.From(EditingMarriage?.EndDate);
        _endDateInvalid = false;
        _endReason = EditingMarriage?.EndReason;
        // Not carried over: the offer is made in response to choosing a reason, so
        // a suggestion left over from the last time this dialog was open would
        // appear under a form nobody had asked it about.
        _deathSuggestion = null;

        _error = null;
    }

    private void ChooseKind(RelationshipKind kind)
    {
        _kind = kind;
        _error = null;
    }

    private Task OnPersonChosen(PersonSummaryDto? person)
    {
        _person = person;
        _error = null;

        // The offer belongs to whoever was chosen when the end reason was picked.
        // Changing the spouse and stepping forward otherwise left it showing the
        // previous person's death year under the new person's form — a date
        // presented as theirs that was somebody else's.
        _deathSuggestion = null;
        return Task.CompletedTask;
    }

    private void OnAdoptionDateChanged(PartialDate? date)
    {
        _adoptionDate = date;
        _error = null;
    }

    private void OnStartDateChanged(PartialDate? date)
    {
        _startDate = date;
        _error = null;
    }

    private void OnEndDateChanged(PartialDate? date)
    {
        _endDate = date;
        _error = null;
    }

    /// <summary>
    /// US-026: choosing "Widowed" asks the tree whether it already knows when.
    /// </summary>
    /// <remarks>
    /// The lookup happens here rather than when the dialog opens, because it is an
    /// answer to the reason being chosen — and because asking on open would read
    /// both people's records on every relationship dialog in the app, whatever kind
    /// it was recording.
    /// </remarks>
    private async Task OnEndReasonChangedAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        _endReason = Enum.TryParse<MarriageEndReason>(raw, out var reason) ? reason : null;
        _error = null;

        if (_endReason != MarriageEndReason.DeathOfSpouse || _person is null)
        {
            _deathSuggestion = null;
            return;
        }

        var suggestion = await Marriages.SuggestEndDateFromSpouseDeathAsync(SubjectId, _person.Id);
        _deathSuggestion = suggestion.IsSuccess ? suggestion.Value : null;
    }

    /// <summary>
    /// Fills the end date from the offer, in both the value and the boxes.
    /// </summary>
    /// <remarks>
    /// Both, because the control is seeded from the text: setting only the parsed
    /// value would leave the field looking empty and save a date the user never saw.
    /// </remarks>
    private void UseSuggestedEndDate(EndDateSuggestion suggestion)
    {
        _endDate = suggestion.Date;
        _endDateSeed = PartialDateText.From(suggestion.Date);
        _endDateInvalid = false;

        // The seed alone is not enough: the control reads it once and then owns
        // its contents, so without a new key the year would be saved while the
        // box stayed empty — a value stored without being displayed, which is the
        // failure mode this project treats as a defect rather than a cosmetic
        // complaint.
        _endDateSeedGeneration++;
    }

    private void OnCertaintyChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<RelationshipCertainty>(args.Value?.ToString(), out var certainty))
        {
            _certainty = certainty;
        }
    }

    private void Next()
    {
        _error = null;
        _step = _step == Step.Kind ? Step.Person : Step.Details;
    }

    private void Back()
    {
        _error = null;
        _step = _step == Step.Details ? Step.Person : Step.Kind;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CancelAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            // Before focus: focusing raises the soft keyboard, and the overlay
            // must already be tracking the visual viewport when it shrinks.
            await Overlay.OpenAsync(_overlay);
            await _panel.FocusAsync();
        }
        else if (!Visible && _wasVisible)
        {
            _wasVisible = false;
            await Overlay.CloseAsync(_overlay);
        }
    }

    // Closing by navigation destroys the component without a further render, so
    // the page would stay pinned unless the lock is released here too.
    public async ValueTask DisposeAsync()
    {
        if (_wasVisible)
        {
            _wasVisible = false;
            try
            {
                await Overlay.CloseAsync(_overlay);
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; the lock goes with it.
            }
        }
    }

    private async Task CancelAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    /// <summary>
    /// The one mutation this wizard is about to perform, chosen from its mode and
    /// its kind.
    /// </summary>
    /// <remarks>
    /// Returns the non-generic <see cref="Result"/> because the callers disagree
    /// about what they return — the adds and replaces hand back a new link id,
    /// the edit has none to hand back — and the dialog uses none of it. Flattening
    /// here keeps <see cref="SaveAsync"/> about what to do with success and
    /// failure rather than about which overload produced them.
    /// </remarks>
    private async Task<Result> SaveResultAsync()
    {
        var chosen = _person!;

        if (IsReplacing)
        {
            return Flatten(await Relationships.ReplaceParentAsync(
                SubjectId, ReplacingParentId!.Value, chosen.Id, _certainty));
        }

        if (IsEditingMarriage)
        {
            // Same spouse: the dates, the place, the reason or the certainty
            // changed and nobody is questioning who this marriage names. That is
            // the ordinary case here — ending a marriage goes down this branch —
            // and sending it through the replace path would delete the record and
            // write a new one with a new id to add a divorce date, taking the
            // stepparent labels resting on it along the way.
            return chosen.Id == EditingMarriage!.Spouse.Id
                ? await Marriages.UpdateAsync(
                    EditingMarriage.MarriageId, _startDate!, _startPlace,
                    _endDate, _endReason, _certainty)
                : Flatten(await Marriages.ReplaceSpouseAsync(
                    EditingMarriage.MarriageId, SubjectId, chosen.Id, _startDate!,
                    _startPlace, _endDate, _endReason, _certainty));
        }

        if (IsEditing)
        {
            // Same person: the date or the certainty changed, and nothing about
            // who this is. Sending that through the replace path would delete a
            // link and write a new one with a new id to record a corrected year.
            return chosen.Id == Editing!.Parent.Id
                // (parent, child), in that order: this mode edits an adoptive
                // parent of the subject, so the subject is the child.
                ? await Adoptive.UpdateAsync(Editing.Parent.Id, SubjectId, _adoptionDate, _certainty)
                : Flatten(await Adoptive.ReplaceParentAsync(
                    SubjectId, Editing.Parent.Id, chosen.Id, _adoptionDate, _certainty));
        }

        return _kind switch
        {
            RelationshipKind.BiologicalChild =>
                Flatten(await Relationships.AddChildAsync(SubjectId, chosen.Id, _certainty)),
            RelationshipKind.AdoptiveParent =>
                Flatten(await Adoptive.AddParentAsync(SubjectId, chosen.Id, _adoptionDate, _certainty)),
            RelationshipKind.AdoptiveChild =>
                Flatten(await Adoptive.AddChildAsync(SubjectId, chosen.Id, _adoptionDate, _certainty)),
            RelationshipKind.Spouse =>
                Flatten(await Marriages.AddAsync(
                    SubjectId, chosen.Id, _startDate!, _startPlace,
                    _endDate, _endReason, _certainty)),
            _ => Flatten(await Relationships.AddParentAsync(SubjectId, chosen.Id, _certainty)),
        };
    }

    /// <summary>Drops a link id the dialog has no use for, keeping the warning.</summary>
    private static Result Flatten<T>(Result<T> result) => result switch
    {
        { IsSuccess: false } => Result.Failure(result.Error!),
        { IsWarning: true } => Result.SuccessWithWarning(result.Warning!),
        _ => Result.Success(),
    };

    private string SavedMessage(PersonSummaryDto chosen)
    {
        if (IsReplacing)
        {
            return $"{chosen.DisplayName} replaced {ReplacingParentName}.";
        }

        if (IsEditingMarriage)
        {
            return chosen.Id == EditingMarriage!.Spouse.Id
                ? $"The marriage to {chosen.DisplayName} was updated."
                : $"{chosen.DisplayName} replaced {EditingMarriage.Spouse.DisplayName} "
                    + "as the recorded spouse.";
        }

        if (IsEditing)
        {
            return chosen.Id == Editing!.Parent.Id
                ? $"{chosen.DisplayName}'s adoption details updated."
                : $"{chosen.DisplayName} replaced {Editing.Parent.DisplayName}.";
        }

        return $"{chosen.DisplayName} linked to {SubjectName}.";
    }

    private async Task SaveAsync()
    {
        if (_person is null)
        {
            _error = "Choose a person first.";
            _step = Step.Person;
            return;
        }

        // Checked here as well as in the service: Save is disabled while the box
        // is empty, so reaching this means the form was submitted some other way,
        // and "A marriage needs a start date" is more use than the service's
        // refusal arriving with no field named.
        if (IsMarriage && _startDate is null)
        {
            _error = "A marriage needs a start date.";
            return;
        }

        _busy = true;
        try
        {
            // Every rule — the two-parent cap, duplicates, the cycle check — is
            // enforced by the service rather than here. This is one of several
            // ways into the same mutation (the tree's own actions arrive in
            // PR 10), and a guard that lives in a component protects one of them.
            var result = await SaveResultAsync();

            if (!result.IsSuccess)
            {
                // Kept open on the details step, showing the reason. Closing on a
                // refusal would lose the chosen person and leave the user to
                // rediscover the rule by repeating the whole wizard.
                _error = result.Error;
                return;
            }

            await Notifier.NotifyChangedAsync();
            Toasts.Show(SavedMessage(_person));

            if (result.IsWarning)
            {
                Toasts.Show(result.Warning!, ToastLevel.Warning);
            }

            Visible = false;
            await VisibleChanged.InvokeAsync(false);
            await Saved.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
